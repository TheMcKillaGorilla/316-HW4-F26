# Copy this file to .env and change anything that differs on your machine.
# .env is not committed, so each of you can have your own.
PORT=4000

# postgres://USER:PASSWORD@HOST:PORT/DATABASE. Put in the password you chose
# when you installed PostgreSQL, and create the wolfie_lists database first.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wolfie_lists

# The key every login token is signed with. Make your own long random one, i.e.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Anyone who knows it can log in as anybody, so never commit it.
JWT_SECRET=replace-me-with-a-long-random-string
